@{
    Layout = null;
}
@model ForgotPasswordViewModel

<style>
    /* Similar styling as registration view */
    body {
        font-family: 'Arial', sans-serif;
        background: linear-gradient(to bottom right, rgb(18, 35, 54), #d1a663);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        color: #333;
    }

    .forgot-password-container {
        width: 450px;
        background: #ffffff;
        border-radius: 15px;
        padding: 40px 30px;
        box-shadow: 0px 10px 20px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    .forgot-password-container h2 {
        font-size: 26px;
        font-weight: bold;
        color: rgb(18, 35, 54);
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .form-group label {
            font-size: 14px;
            color: rgb(18, 35, 54);
            margin-bottom: 5px;
            display: block;
        }

        .form-group input {
            width: 100%;
            padding: 12px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 14px;
            background: #f8f8f8;
        }

    .btn-reset {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        font-weight: bold;
        background-color: rgb(18, 35, 54);
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
    }

    .btn-reset:hover {
        background-color: #d1a663;
    }
</style>

<div class="forgot-password-container">
    <h2>Reset Your Password</h2>

    @if (ViewBag.Message != null)
    {
        <div style="color: red; font-size: 14px; margin-bottom: 15px;">
            @ViewBag.Message
        </div>
    }

    <form method="post">
        <div class="form-group">
            <label for="Email">Email</label>
            <input type="email" id="Email" name="Email" placeholder="Enter your email address" required />
        </div>
        <div class="form-group">
            <label for="NewPassword">New Password</label>
            <input type="password" id="NewPassword" name="NewPassword" placeholder="Enter new password" required />
        </div>

        <div class="form-group">
            <label for="ConfirmPassword">Confirm Password</label>
            <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Confirm new password" required />
        </div>

        <button type="submit" class="btn-reset">Reset Password</button>
    </form>
</div>
