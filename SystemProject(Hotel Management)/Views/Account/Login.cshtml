@model LoginViewModel
@{
    Layout = null;
}

<style>
    /* Background styling */
    body {
        font-family: 'Arial', sans-serif;
        background: linear-gradient(135deg, #dfe9f3, #ffffff);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        color: #333333;
    }

    /* Main container */
    .login-container {
        width: 400px;
        background: linear-gradient(135deg, #ffffff, #f7f7f7);
        border-radius: 12px;
        padding: 40px;
        box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

    /* Logo styling */
    .logo-container img {
        width: 80px;
        height: auto;
        margin-bottom: 20px;
    }

    /* Heading */
    .login-container h2 {
        font-size: 26px;
        font-weight: bold;
        margin-bottom: 10px;
        color: #4a4a4a;
    }

    .login-container p.subtitle {
        font-size: 14px;
        margin-bottom: 30px;
        color: #777777;
    }

    /* Form fields */
    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .form-group label {
            font-size: 14px;
            color: #555555;
            margin-bottom: 8px;
            display: block;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #cccccc;
            border-radius: 8px;
            font-size: 14px;
            background: #ffffff;
            box-shadow: inset 0px 2px 4px rgba(0, 0, 0, 0.05);
            transition: all 0.3s;
        }

            .form-group input:focus {
                border-color: #6c757d;
                outline: none;
                background: #f9f9f9;
            }

    /* Login button */
    .btn-login {
        width: 100%;
        padding: 12px;
        font-size: 16px;
        font-weight: bold;
        background: linear-gradient(135deg, #6c757d, #343a40);
        color: white;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s;
    }

        .btn-login:hover {
            background: linear-gradient(135deg, #343a40, #6c757d);
            transform: translateY(-2px);
        }

    /* Links */
    .login-container p a {
        text-decoration: none;
        color: #343a40;
        font-weight: bold;
        transition: color 0.3s;
    }

        .login-container p a:hover {
            color: #6c757d;
        }

    /* Footer link */
    .footer-link {
        font-size: 12px;
        margin-top: 20px;
        color: #777777;
    }

        .footer-link a {
            color: #343a40;
        }
</style>

<div class="login-container">
    <div class="logo-container">
        <img src="/images/B__3_-removebg-preview.png" alt="Logo">
    </div>
    <h2>Welcome to BiteHub</h2>
    <p class="subtitle">Login to access your account</p>
    @if (ViewBag.Message != null)
    {
        <div style="color: red; font-size: 14px; margin-bottom: 15px;">
            @ViewBag.Message
        </div>
    }
    <form method="post">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="form-group">
            <label for="Email">Email</label>
            <input type="email" class="form-control" id="Email" name="Email" placeholder="Enter your email" required />
        </div>

        <div class="form-group">
            <label for="Password">Password</label>
            <input type="password" class="form-control" id="Password" name="Password" placeholder="Enter your password" required />
        </div>

        <button type="submit" class="btn-login">Login</button>
    </form>

    <p>
        Don't have an account? <a href="/Account/Register">Register here</a>
    </p>

    <p class="footer-link">
        Forgot your password? <a href="/Account/ForgotPassword">Click here</a>
    </p>
</div>
