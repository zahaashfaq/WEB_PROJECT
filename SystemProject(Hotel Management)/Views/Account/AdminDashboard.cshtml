@{
    Layout = null;
}
<style>
    /* General styling */
    body {
        font-family: 'Arial', sans-serif;
        background-color: #f4f7f6;
        color: #333;
    }

    h2 {
        font-size: 2rem;
        color: #333;
        text-align: center;
        margin-top: 30px;
    }

    /* Admin Dashboard Styling */
    .admin-dashboard {
        width: 80%;
        margin: 0 auto;
        background-color: #fff;
        padding: 30px;
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        border-radius: 8px;
        margin-top: 40px;
    }

        .admin-dashboard p {
            text-align: center;
            font-size: 1.2rem;
            color: #555;
            margin-bottom: 30px;
        }

        /* Navigation Styling */
        .admin-dashboard ul {
            list-style-type: none;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .admin-dashboard li {
            width: 100%;
            margin-bottom: 20px;
        }

        .admin-dashboard a {
            display: block;
            text-align: center;
            background-color: #4CAF50;
            color: white;
            font-size: 1.1rem;
            padding: 15px;
            border-radius: 8px;
            text-decoration: none;
            transition: background-color 0.3s;
            width: 60%;
            margin: 0 auto;
        }

            .admin-dashboard a:hover {
                background-color: #45a049;
                box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
            }

            .admin-dashboard a:focus {
                outline: none;
                background-color: #388e3c;
            }

</style>
<div class="admin-dashboard">
    <h2>Admin Dashboard</h2>
    <p>Welcome, Admin!</p>
    <ul>
        <li><a href="/Admin/ManageProduct">Manage Product</a></li>
        <li><a href="/Admin/ViewOrders">View Orders</a></li>
        <li><a href="/Admin/ManageUsers">Manage Users</a></li>
        <li><a href="/Admin/EditTables">View and Edit Table information</a></li>
        <li><a href="/Admin/ViewReservation">View Reservations</a></li>
        <li><a href="/Admin/ViewReports">View Reports</a></li>
        <li><a href="/Main/Index">Go to HomePage</a></li>
    </ul>
</div>
