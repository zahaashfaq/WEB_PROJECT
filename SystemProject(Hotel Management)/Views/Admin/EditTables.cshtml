@{
    Layout = null;
}

@model List<SystemProject_Hotel_Management_.Models.Table>

<style>
    /* General Styles */
    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f8f9fa; /* Light gray background */
        padding: 20px;
    }

    h2 {
        text-align: center;
        margin-bottom: 30px;
        color: #333; /* Dark text color */
        font-size: 2rem;
        font-weight: bold;
        text-transform: uppercase;
    }

    /* Table Styling */
    .table-container {
        background-color: #fff; /* White background */
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15); /* Stronger shadow */
        border: 1px solid #ddd; /* Light border */
        overflow-x: auto; /* Scrollable on small screens */
    }

    .table {
        margin: 0;
        width: 100%;
    }

    thead {
        background-color: #007bff; /* Bootstrap primary color */
        color: #fff;
        text-align: center;
    }

        thead th {
            padding: 15px;
            font-size: 1rem;
            text-transform: uppercase;
        }

    tbody tr {
        transition: all 0.3s ease-in-out; /* Smooth hover effect */
    }

        tbody tr:hover {
            background-color: #f0f8ff; /* Light blue hover effect */
            transform: scale(1.02); /* Slight zoom on hover */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1); /* Subtle shadow */
        }

    tbody td {
        text-align: center;
        padding: 12px;
        vertical-align: middle;
    }

        tbody td:first-child {
            font-weight: bold;
            color: #007bff; /* Highlight Table Number */
        }

    /* Button Styles (Optional) */
    .btn-back {
        display: block;
        margin: 20px auto 0;
        background-color: #007bff;
        color: white;
        text-transform: uppercase;
        font-size: 0.9rem;
        padding: 10px 20px;
        border-radius: 5px;
        transition: all 0.3s ease-in-out;
        text-decoration: none;
    }

        .btn-back:hover {
            background-color: #0056b3;
            color: #fff;
            transform: translateY(-3px);
        }

    .btn-primary {
        text-decoration:none;
        background-color: #007bff;
        border-color: #007bff;
        color: #fff;
        font-size: 0.9rem;
        padding: 8px 15px; /* Increased padding */
        border-radius: 25px; /* Rounded edges for modern look */
        text-transform: uppercase; /* Consistent with other styles */
        font-weight: bold;
        transition: all 0.3s ease-in-out; /* Smooth transition on hover */
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Subtle shadow for depth */
    }

        .btn-primary:hover {
            background-color: #0056b3; /* Darker shade for hover */
            border-color: #0056b3;
            color: #fff;
            transform: scale(1.05); /* Slightly enlarge on hover */
            box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15); /* Enhanced shadow effect */
        }
</style>

<div>
    <h2>Manage Tables</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger text-center">@TempData["Error"]</div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }

    <div class="table-container">
        <table class="table">
            <thead>
                <tr>
                    <th>Table Number</th>
                    <th>Seats</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var table in Model)
                {
                    <tr>
                        <td>@table.TableNumber</td>
                        <td>@table.Seats</td>
                        <td>
                            <span class="badge @(table.Status.ToLower() == "available" ? "bg-success" : "bg-danger")">
                                @table.Status
                            </span>
                        </td>
                        <td>
                            <a href="@Url.Action("EditTable", "Admin", new { id = table.Id })"
                               class="btn btn-primary">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <a href="/Account/AdminDashboard" class="btn btn-back">Go Back</a>
</div>
