@{
    Layout = null; // Set your layout page if using one.
}
@model List<OrderViewModel1>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>View Orders</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <style>
        /* General Styles */
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            padding: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #333;
            font-size: 2rem;
            font-weight: bold;
            text-transform: uppercase;
        }

        /* Table Styling */
        .table-container {
            background-color: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 6px 10px rgba(0, 0, 0, 0.15);
            border: 1px solid #ddd;
            overflow-x: auto;
        }

        .table {
            margin: 0;
            width: 100%;
        }

        thead {
            background-color: #007bff;
            color: #fff;
            text-align: center;
        }

        thead th {
            padding: 15px;
            font-size: 1rem;
            text-transform: uppercase;
        }

        tbody tr {
            transition: all 0.3s ease-in-out;
        }

        tbody tr:hover {
            background-color: #f0f8ff;
            transform: scale(1.02);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        tbody td {
            text-align: center;
            padding: 12px;
            vertical-align: middle;
        }

        tbody td:first-child {
            font-weight: bold;
            color: #007bff;
        }

        /* Button Styles */
        .btn-back {
            display: block;
            margin: 20px auto 0;
            background-color: #007bff;
            color: white;
            text-transform: uppercase;
            font-size: 0.9rem;
            padding: 10px 20px;
            border-radius: 5px;
            transition: all 0.3s ease-in-out;
            text-align: center;
            width: fit-content;
        }

        .btn-back:hover {
            background-color: #0056b3;
            color: #fff;
            transform: translateY(-3px);
        }

        .status-dropdown {
            width: 100%;
            padding: 6px;
            font-size: 0.9rem;
            border-radius: 5px;
        }
    </style>
</head>
<body>
    <h2>View Orders</h2>

    <div class="table-container">
        @if (Model == null || !Model.Any())
        {
            <p class="text-center text-muted">No orders available.</p>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer Name</th>
                        <th>Order Date</th>
                        <th>Total Amount</th>
                        <th>Status</th>
                        <th>Street Address</th>
                        <th>City</th>
                        <th>Phone Number</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.OrderID</td>
                            <td>@order.CustomerName</td>
                            <td>@order.OrderDate.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>@order.TotalAmount.ToString("C")</td>
                            <td id="order-status-@order.OrderID">@order.Status</td>
                            <td>@order.StreetAddress</td>
                            <td>@order.City</td>
                            <td>@order.PhoneNumber</td>
                            <td>
                                <select id="status-dropdown-@order.OrderID" class="form-select">
                                    <option value="Pending" selected="@(order.Status == "Pending" ? "selected" : null)">Pending</option>
                                    <option value="Processing" selected="@(order.Status == "Processing" ? "selected" : null)">Processing</option>
                                    <option value="Completed" selected="@(order.Status == "Completed" ? "selected" : null)">Completed</option>
                                    <option value="Cancelled" selected="@(order.Status == "Cancelled" ? "selected" : null)">Cancelled</option>
                                </select>
                                <button class="btn btn-primary mt-2" onclick="updateOrderStatus(@order.OrderID)">Update</button>
                            </td>
                            
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    <a href="/Account/AdminDashboard" class="btn btn-back">Go Back</a>

    <script src="~/js/orderStatus.js"></script> <!-- Include JavaScript -->
</body>
</html>

