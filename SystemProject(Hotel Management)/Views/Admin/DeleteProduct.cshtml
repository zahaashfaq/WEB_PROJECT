@{
    Layout = null;
}

@model DeleteFoodItemViewModel
<style>
    /* General container styling */
    .delete-container {
        border: 1px solid #ddd;
        padding: 20px;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        background-color: #fff;
        max-width: 600px;
        margin: 0 auto;
    }

        /* Title styling */
        .delete-container h2 {
            text-align: center;
            font-size: 1.5em;
            margin-bottom: 20px;
            color: #333;
        }

        /* Product details */
        .delete-container .product-details {
            margin-bottom: 20px;
        }

            /* Product info (Name, Price, Description) */
            .delete-container .product-details strong {
                font-weight: bold;
                color: #555;
            }

            .delete-container .product-details span {
                color: #777;
            }

        /* Image styling */
        .delete-container img {
            display: block;
            max-width: 100%;
            max-height: 200px;
            margin-top: 15px;
            border-radius: 8px;
        }

    /* Button container (Delete & Cancel buttons) */
    .button-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        /* Delete button */
        .button-container .btn-danger {
            background-color: #dc3545;
            border: none;
            color: #fff;
            padding: 10px 20px;
            font-size: 1em;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

            .button-container .btn-danger:hover {
                background-color: #c82333;
            }

        /* Cancel button */
        .button-container .btn-secondary {
            background-color: #6c757d;
            border: none;
            color: #fff;
            padding: 10px 20px;
            font-size: 1em;
            border-radius: 5px;
            text-decoration: none;
            transition: background-color 0.3s ease;
        }

            .button-container .btn-secondary:hover {
                background-color: #5a6268;
            }

</style>
<div class="delete-container">
    <h2>Are you sure you want to delete the following product?</h2>
    <div class="product-details">
        <strong>Name:</strong> @Model.Name <br />
        <strong>Price:</strong> @Model.Price <br />
        <strong>Description:</strong> @Model.Description <br />
        @if (!string.IsNullOrEmpty(Model.PictureURL))
        {
            <img src="@Model.PictureURL" alt="Product Image" />
        }
    </div>
    <div class="button-container">
        <form asp-action="DeleteProduct" method="post">
            <input type="hidden" name="id" value="@Model.ID" />
            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@Url.Action("ManageProduct")" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

