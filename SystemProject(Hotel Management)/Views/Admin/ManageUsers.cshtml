@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    Layout = null;
}
@model List<UserViewModel>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Users</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
            padding: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
            color: #333;
            font-size: 2rem;
            font-weight: bold;
        }

        .table-container {
            background-color: #fff;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
            margin-top: 30px;
        }

        .table th {
            text-transform: uppercase;
            background-color: #007bff;
            color: white;
            text-align: center;
            font-weight: 600;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
        }

        .btn-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn {
            padding: 8px 15px;
            font-size: 0.95rem;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }

        .btn-danger {
            background-color: #dc3545;
            border: none;
        }

            .btn-danger:hover {
                background-color: #c82333;
            }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f2f2f2;
        }

        .table-hover tbody tr:hover {
            background-color: #e9ecef;
        }

        .no-users {
            text-align: center;
            color: #888;
            font-size: 1.1rem;
        }

        .table-container .pagination {
            justify-content: center;
        }

            .table-container .pagination .page-link {
                border-radius: 5px;
                font-size: 1rem;
                padding: 6px 12px;
            }

                .table-container .pagination .page-link:hover {
                    background-color: #007bff;
                    color: white;
                }

        .btn-custom {
            display: inline-block;
            font-size: 1.25rem; /* Large font */
            padding: 15px 30px; /* Vertical and horizontal padding */
            margin: 10px; /* Spacing between buttons */
            border-radius: 50px; /* Pill shape */
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Soft shadow */
            text-decoration: none; /* Remove underline */
            font-weight: 600; /* Bold text */
            transition: transform 0.2s ease, box-shadow 0.2s ease; /* Animation */
        }

            /* Hover effect for all buttons */
            .btn-custom:hover {
                transform: translateY(-3px); /* Slight upward movement */
                box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15); /* Stronger shadow */
            }

        /* Primary button specific styles */
        .btn-primary-custom {
            background-color: #007bff; /* Bootstrap primary blue */
            color: white;
            border: none;
        }

            .btn-primary-custom:hover {
                background-color: #0056b3; /* Darker blue on hover */
            }

        /* Success button specific styles */
        .btn-success-custom {
            background-color: #28a745; /* Bootstrap success green */
            color: white;
            border: none;
        }

            .btn-success-custom:hover {
                background-color: #1e7e34; /* Darker green on hover */
            }

        /* Info button specific styles */
        .btn-info-custom {
            background-color: #17a2b8; /* Bootstrap info blue */
            color: white;
            border: none;
        }

            .btn-info-custom:hover {
                background-color: #117a8b; 
            }
    </style>
</head>
<body>
    <h2>Manage Users</h2>

    <div class="table-container">
        @if (Model == null || !Model.Any())
        {
            <p class="no-users">No users found.</p>
        }
        else
        {
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserId</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>@(user.IsActive ? "Active" : "Inactive")</td>
                            <td>
                                <div class="btn-actions">
                                    <a href="/Admin/EditUser/@user.UserId" class="btn btn-primary">Edit</a>
                                    <a href="/Admin/DeleteUser/@user.UserId" class="btn btn-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination (if needed) -->
            <div class="pagination">
                @* Example pagination controls. Modify based on your pagination setup *@
                <ul class="pagination">
                    <li class="page-item">
                        <a class="page-link" href="#">Previous</a>
                    </li>
                    <li class="page-item active">
                        <a class="page-link" href="#">1</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">2</a>
                    </li>
                    <li class="page-item">
                        <a class="page-link" href="#">Next</a>
                    </li>
                </ul>
            </div>
        }
        <div class="text-center my-5">
            <a href="@Url.Action("AdminDashboard", "Account")"
               class="btn-custom btn-success-custom">
                See Our Menu
            </a>
        </div>
    </div>
</body>
</html>
