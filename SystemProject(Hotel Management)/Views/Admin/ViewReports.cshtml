@{
    Layout = null;
}
@model List<SystemProject_Hotel_Management_.Models.ReportViewModel>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>View Reports</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f7f7f7;
            padding: 20px;
        }

        h2 {
            text-align: center;
            margin-bottom: 40px;
            color: #333;
            font-size: 2.2rem;
            font-weight: bold;
        }

        .table-container {
            background-color: #ffffff;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.1);
            margin-top: 40px;
        }

        .table th {
            text-transform: uppercase;
            background-color: #4CAF50;
            color: white;
            text-align: center;
            font-weight: bold;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
            color: #333;
        }

        .btn-actions {
            display: flex;
            gap: 10px;
            justify-content: center;
        }

        .btn {
            padding: 8px 15px;
            font-size: 1rem;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        .btn-primary {
            background-color: #007bff;
            border: none;
        }

            .btn-primary:hover {
                background-color: #0056b3;
            }

        .btn-secondary {
            background-color: #f7c931;
            border: none;
        }

            .btn-secondary:hover {
                background-color: #e6b72b;
            }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #f4f4f4;
        }

        .table-hover tbody tr:hover {
            background-color: #e1f1f3;
        }

        .no-reports {
            text-align: center;
            color: #888;
            font-size: 1.2rem;
            font-style: italic;
        }

        .report-section {
            margin-bottom: 30px;
            padding-bottom: 30px;
            border-bottom: 2px solid #e1e1e1;
        }

            .report-section h3 {
                font-size: 1.5rem;
                color: #4CAF50;
                font-weight: bold;
            }

            .report-section p {
                font-size: 1.1rem;
                color: #555;
                margin-bottom: 15px;
            }

            .report-section h4 {
                font-size: 1.2rem;
                color: #007bff;
                font-weight: bold;
                margin-top: 20px;
            }

    </style>
</head>
<body>
    <h2>View Reports</h2>

    <div class="table-container">
        @if (Model == null || !Model.Any())
        {
            <p class="no-reports">No reports available.</p>
        }
        else
        {
            @foreach (var report in Model)
            {
                <div class="report-section">
                    <h3>@report.Title</h3>
                    <p><strong>Date Generated:</strong> @report.DateGenerated.ToString("MM/dd/yyyy")</p>
                    <p><strong>Description:</strong> @report.Description</p>

                    <h4>Order Details</h4>
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer Name</th>
                                <th>Total Amount</th>
                                <th>Order Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in report.Orders)
                            {
                                <tr>
                                    <td>@order.OrderID</td>
                                    <td>@order.CustomerName</td>
                                    <td>@order.TotalAmount.ToString("C")</td>
                                    <td>@order.OrderDate.ToString("MM/dd/yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                  
                    
                </div>
            }
        }
    </div>
</body>
</html>
