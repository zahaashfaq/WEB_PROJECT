@{
    Layout = null;
}
@model SystemProject_Hotel_Management_.Models.CheckoutViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f4f7fc;
            margin: 0;
            padding: 0;
            color: #555;
        }

        .container {
            width: 75%;
            margin: 50px auto;
            background-color: #fff;
            border-radius: 15px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
            padding: 40px;
            transition: transform 0.3s ease-in-out;
        }

            .container:hover {
                transform: translateY(-10px);
            }

        h2 {
            color: #2c3e50;
            font-size: 2.2rem;
            margin-bottom: 25px;
            text-align: center;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
            border-radius: 8px;
            overflow: hidden;
            background-color: #f9f9f9;
        }

        th, td {
            padding: 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
            font-size: 1rem;
        }

        th {
            background-color: #2980b9;
            color: white;
        }

        tr:nth-child(even) {
            background-color: #f1f1f1;
        }

        tr:hover {
            background-color: #ecf0f1;
        }

        h3 {
            color: #34495e;
            font-size: 1.3rem;
            margin-top: 30px;
            text-align: right;
        }

        form {
            margin-top: 30px;
            display: grid;
            gap: 20px;
            max-width: 500px;
            margin-left: auto;
            margin-right: auto;
        }

        label {
            font-size: 1.1rem;
            color: #34495e;
        }

        input[type="text"] {
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            background-color: #f9f9f9;
        }

            input[type="text"]:focus {
                border-color: #2980b9;
                outline: none;
                background-color: #ecf0f1;
            }

        button {
            padding: 15px 25px;
            font-size: 1.2rem;
            color: #fff;
            background-color: #27ae60;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.3s ease;
            font-weight: bold;
        }

            button:hover {
                background-color: #2ecc71;
                transform: scale(1.05);
            }

        .empty-cart-message {
            background-color: #f8d7da;
            padding: 20px;
            border-radius: 10px;
            color: #721c24;
            margin-top: 20px;
            text-align: center;
        }

            .empty-cart-message a {
                color: #2980b9;
                text-decoration: none;
                font-weight: bold;
            }

                .empty-cart-message a:hover {
                    text-decoration: underline;
                }

        .total-amount {
            font-size: 1.6rem;
            color: #27ae60;
            font-weight: bold;
            text-align: right;
            margin-top: 25px;
        }

        .footer-note {
            text-align: center;
            margin-top: 40px;
            color: #aaa;
            font-size: 0.9rem;
        }

            .footer-note a {
                color: #2980b9;
                text-decoration: none;
            }

                .footer-note a:hover {
                    text-decoration: underline;
                }
    </style>
</head>
<body>
    <div class="container">
        <h2>Checkout</h2>

        @if (Model.CartItems == null || !Model.CartItems.Any())
        {
            <div class="empty-cart-message">
                <p>Your cart is empty. <a asp-action="ViewCart" asp-controller="Cart">Go back to the cart</a>.</p>
            </div>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Price</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.CartItems)
                    {
                        <tr>
                            <td>@item.FoodItemName</td>
                            <td>@item.Quantity</td>
                            <td>@item.Price.ToString("C")</td>
                            <td>@item.Total.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="total-amount">
                <p>Total: @Model.TotalAmount.ToString("C")</p>
            </div>

            <form asp-action="Checkout" method="post">
                <div>
                    <label for="StreetAddress">Street Address:</label>
                    <input type="text" id="StreetAddress" name="StreetAddress" value="@Model.StreetAddress" required />
                </div>
                <input type="hidden" asp-for="TotalAmount" />
                <div>
                    <label for="City">City:</label>
                    <input type="text" id="City" name="City" value="@Model.City" required />
                </div>
                <div>
                    <label for="PhoneNumber">Phone Number:</label>
                    <input type="text" id="PhoneNumber" name="PhoneNumber" value="@Model.PhoneNumber" required />
                </div>
                <button type="submit">Place Order</button>
            </form>
        }
    </div>

    <div class="footer-note">
        <p>&copy; 2024 Restaurant | <a href="#">Privacy Policy</a> | <a href="#">Terms of Service</a></p>
    </div>
</body>
</html>
