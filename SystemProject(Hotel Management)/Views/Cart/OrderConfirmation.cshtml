@{
    Layout = null;
}

@model SystemProject_Hotel_Management_.Models.OrderDetailsViewModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmation</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            background-color: #f8f9fa;
            color: #333;
            margin: 0;
            padding: 0;
        }

        .container {
            width: 80%;
            margin: 50px auto;
            padding: 20px;
            background-color: white;
            border-radius: 8px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        h2 {
            color: #28a745;
            font-size: 2rem;
            margin-bottom: 20px;
        }

        .order-summary {
            margin-top: 30px;
            padding: 20px;
            background-color: #f1f1f1;
            border-radius: 5px;
        }

        .order-summary h3 {
            margin-bottom: 15px;
            color: #343a40;
        }

        

        .address, .phone {
            font-weight: bold;
            color: #007bff;
        }

        .status {
            font-size: 1.2rem;
            color: #17a2b8;
        }

        .total-amount {
            font-size: 1.5rem;
            color: #28a745;
            font-weight: bold;
            margin-top: 20px;
        }

        .btn {
            display: inline-block;
            padding: 10px 20px;
            margin-top: 30px;
            background-color: #007bff;
            color: white;
            font-size: 1.1rem;
            text-decoration: none;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .btn:hover {
            background-color: #0056b3;
        }

        .order-details {
            margin-top: 30px;
        }

        .order-details th, .order-details td {
            padding: 10px;
            text-align: left;
        }

        .order-details th {
            background-color: #007bff;
            color: white;
        }

        .order-details tr:nth-child(even) {
            background-color: #f8f9fa;
        }

        .order-details td {
            font-size: 1.1rem;
        }
    </style>
</head>
<body>
    <div class="container">
        <h2>Order Confirmation</h2>

        <p>Thank you for your order, <strong>@Model.UserName!</strong></p>
        <p>Order ID: <strong>@Model.OrderID</strong></p>
        <p>Order Date: <strong>@Model.CreatedAt.ToString("f")</strong></p>

        <!-- Order Status Element -->
        <p>Order Status: <strong id="order-status-@Model.OrderID">@Model.Status</strong></p>
        @*  // <p class="status">Status: <strong>@Model.Status</strong></p> *@

        <div class="order-summary">
            <h3>Delivery Details</h3>
            <p><span class="address">Address:</span> @Model.StreetAddress, @Model.City</p>
            <p><span class="phone">Phone:</span> @Model.PhoneNumber</p>
        </div>

        

        <div class="total-amount">
            <p>Total Amount: @Model.TotalAmount.ToString("C")</p>
        </div>

        <a asp-action="Index" asp-controller="Main" class="btn">Back to Home</a>
    </div>
</body>
</html>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script src="~/js/orderStatus.js"></script>
