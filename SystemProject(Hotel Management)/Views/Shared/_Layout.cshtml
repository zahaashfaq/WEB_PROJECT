<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SystemProject_Hotel_Management_</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SystemProject_Hotel_Management_.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="@Url.Content("~/css/StyleSheet.css")">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Luminari&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/icofont/1.0.1/css/icofont.min.css" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg sticky-top navbar1 ">
            <div class="container-fluid">
                <a class="navbar-brand col-6 col-lg-6 d-flex justify-content-start justify-content-lg-end align-items-center p-0" href="#">
                    <img src="/images/B__3_-removebg-preview.png" alt="Logo" style="height: 90px; width: 130px;filter: brightness(1.2);padding:0;"> 
                    <h1 style=" font-family: 'Cinzel', serif;color: white;font-size: 2rem;font-weight: bold;text-transform: uppercase;padding:0">
                        Bite Hub
                    </h1>
                </a>

                <div class="collapse navbar-collapse col-6  col-lg-4 justify-content-end" id="navbarNavAltMarkup">
                    <div class="navbar-nav">
                        <a class="nav-link d-none d-lg-block" href="#">

                            <button class="btn btn-outline-light  me-4 button" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasReservation" aria-controls="offcanvasReservation" style="padding:11px; color: white;font-size:1rem;border: solid;border-color: white;border-radius: 22px;background-color: transparent;">
                                Book the Table
                            </button>


                        </a>

                        <a class="nav-link d-none d-lg-block" href="https://www.whatsapp.com/" target="_blank">
                            <i class="bi bi-whatsapp  me-4" style="  font-size: 34px;color: white"></i>
                        </a>
                    </div>

                </div>
                <button class="nav-link ms-auto d-lg-none btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasTop" aria-controls="offcanvasTop" aria-expanded="false" aria-label="Toggle navigation">

                    <i class="fas fa-bars" style="color:white; font-size: 30px; font-weight: bold;"></i>

                </button>

                <button class="nav-link ms-auto d-none d-lg-block btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasTop" aria-controls="offcanvasTop" aria-expanded="false" aria-label="Toggle offcanvas">
                    <i class="fas fa-bars" style="color:white; font-size: 30px; font-weight: bold;"></i>
                </button>


            </div>
        </nav>

        @* ///// *@
        <div class="offcanvas offcanvas-top" tabindex="-1" id="offcanvasReservation" aria-labelledby="offcanvasReservationLabel">
            <div class="offcanvas-header">
                <div class="offcanvas-title col-6 d-flex align-items-center">
                    <img src="/images/B__3_-removebg-preview.png" alt="Logo" style="height: 90px; margin-right: 15px;">
                    <h1>Bite Hub</h1>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
            </div>
            <div class="offcanvas-body">
                <h1 class="text-center mb-4">Make a Booking</h1>
                <partial name="_PR" model="@Model"></partial>
            </div>
        </div>


        @* ----Offcanvas for toggle----- *@
        <div class="offcanvas offcanvas-top" tabindex="-1" id="offcanvasTop" aria-labelledby="offcanvasTopLabel">
            <div class="Toffcanvas-body">
                <div class="container-fluid h-100 mt-0">
                    <div class="row h-100 mt-0">
                        <!-- Menu Section -->
                        <div class=" menu-section col-lg-4 col-12  text-white d-flex flex-column  p-3">
                            <header class="menu-header mb-4">
                                <img src="/images/B__3_-removebg-preview.png" alt="Logo" class="img-fluid" style="height: 90px;">
                                <h1 class="heading mt-3">Bite Hub</h1>
                            </header>
                            <nav class="navbar navbar-expand-lg vertical-navbar align-items-center">
                                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                                    <span class="navbar-toggler-icon"></span>
                                </button>
                                <div class="collapse navbar-collapse" id="navbarNav">
                                    <ul class="navbar-nav flex-column">
                                        <li class="nav-item">
                                            <a class="nav-link" asp-controller="Main" asp-action="Index">Home</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="@Url.Action("ViewMenu", "Menu")">Menu</a>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link" href="@Url.Action("gallery", "Menu")">Gallery</a>
                                        </li>
                                       
                                        <li class="nav-item">
                                            <a class="nav-link" href="@Url.Action("contactUs", "Menu")">Contact</a>
                                        </li>
                                        
                                        <li class="nav-item d-flex align-items-center">
                                            <a class="nav-link icon p-0 me-3" href="https://www.instagram.com/" target="_blank">
                                                <i class="bi bi-instagram social-icon instagram-icon" style="font-size: 34px; color: white;"></i>
                                            </a>
                                            <a class="nav-link icon p-0 ms-5" href="https://www.facebook.com/?_rdr" target="_blank">
                                                <i class="bi bi-facebook social-icon facebook-icon" style="font-size: 34px; color: white;"></i>
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </nav>
                        </div>

                        <!-- Reservation Section -->
                        <div class=" reservation-section col-lg-8 col-12 d-flex flex-column align-items-center justify-content-center">
                            <button type="button" class="btn-close align-self-end m-3" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                            <h1 class="text-center mb-4" style="font-family: 'Poppins', sans-serif; font-weight: 500;">Make a Booking</h1>
                            <partial name="_PR" model="@Model"></partial>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </header>
    <div class="main">
        <main role="main" class="pb-0">
            @RenderBody()
        </main>
    </div>

    <footer style="margin-top:0;">
        <div class="footer-main  text-white py-4 mb-5">
            <div class="container-fluid mt-4">
                <div class="row">
                    <!-- Left Column -->
                    <div class="col-md-4 text-center text-md-start text-lg-center">
                        <img src="/images/B__3_-removebg-preview.png" alt="Logo" class="img-fluid" style="height: 160px;width:120px;">
                        <h2 class="mb-1 mt-0" style="color:#A2683C;">BITE HUB</h2>
                    </div>
                    <!-- Middle Column -->
                    <div class="col-md-4 text-start">
                        <h5 class="footer-title text-light fs-3 fw-medium">OPENING HOURS</h5>
                        <p class="mb-1" style=" color:#A2683C;">GRAND CAFE</p>
                        <h6 class="footer-title text-light fs-5 fw-medium" >Monday–Sunday: 07:00 - 23:00</h6>
                        <p class="mb-1" style=" color:#A2683C;">MUSIC & KAWALI</p>
                        <h6 class="footer-title text-light fs-5 fw-medium">Monday - Sunday: 10:00 - 02:00</h6>
                        <p class="mb-1" style=" color:#A2683C;">FIND US</p>
                        <h6 class="footer-title text-light fs-5 fw-medium">84-86 MM-Alam Road, Lahore Gulberg</h6>
                    </div>
                    <!-- Right Column -->
                    <div class="col-md-4 text-start text-md-start">
                        <h5 class="footer-title text-light fs-3 fw-medium">SOCIAL LINKS</h5>
                        <a href="#" class="social-icon me-5" style="color:#A2683C;"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="social-icon" style=" color:#A2683C;"><i class="fab fa-facebook"></i></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom text-white">
            <div class="container-fluid d-flex flex-column flex-md-row justify-content-between align-items-center">
                <p class="mb-1 fs-6 align-items-end">© 2024 Bite Hub Grand Café</p>
                <div class="footer-links ">
                    <a href="#" class="footer-link me-3">Cookies Policy</a>
                    <a href="#" class="footer-link me-3">Privacy Policy</a>
                    <a href="#" class="footer-link me-3">Terms of Use</a>
                    <a href="#" class="footer-link me-3">Cookie Setting</a>
                    <a href="#" class="footer-link me-3">Website by ignite</a>
                </div>
            </div>
        </div>
    </footer>

    <script>
        window.onscroll = function () {
            changeNavbarBackground();
        };

        function changeNavbarBackground() {
            var navbar = document.querySelector('.navbar');

            if (window.scrollY >= 610) {
                navbar.classList.add('scrolled', 'sticky-top');
            } else {
                navbar.classList.remove('scrolled');
            }
        }
    </script>


   @*  <script src="~/lib/jquery/dist/jquery.min.js"></script> *@
     <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/orderStatus.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
