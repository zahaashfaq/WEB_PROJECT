@using System.Security.Claims
@model IEnumerable<SystemProject_Hotel_Management_.Models.FoodItemViewModel>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <style>
        .menu-section {
            padding: 3px 20px;
            text-align: center;
            background-color: #f9f9f9;
        }

        .section-title {
            font-size: 30px;
            margin-bottom: 20px;
            color: #C0272C;
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            justify-items: center;
        }

        .menu-item {
            background-color: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            transition: transform 0.3s, box-shadow 0.3s;
            max-width: 280px;
            height: 480px;
            text-align: left;
        }

        .menu-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .menu-image {
            width: 100%;
            height: 50%;
            display: flex;
            justify-items: center;
        }

        .menu-name {
            font-weight: 900;
            font-size: 7em;
            margin: 15px 10px 5px;
            color: #C0272C;
            letter-spacing: -1px;
            text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.3);
        }

        .menu-description {
            font-size: 1em;
            color: #666;
            margin: 0 10px 10px;
        }

        .menu-price {
            font-weight: 900;
            font-size: 7em;
            color: #C0272C;
            margin: 0 10px 15px;
            letter-spacing: -1px;
            text-shadow: 2px 2px 3px rgba(0, 0, 0, 0.3);
        }

        .order-button {
            display: block;
            width: calc(100% - 20px);
            margin: 0 10px 15px;
            background-color: rgb(18, 35, 54);
            color: #fff;
            border: none;
            padding: 10px 0;
            border-radius: 5px;
            cursor: pointer;
            text-align: center;
            transition: background-color 0.3s;
        }

        .order-button:hover {
            background-color: #a0522d;
        }




        /* Custom Modal Styling */
        .custom-modal {
            background-color: rgb(18, 35, 54);
            color: white;
            border: 2px solid #FFC107;
        }

        .custom-modal-header {
            background-color: #C0272C;
            color: white;
        }

        .custom-modal .close-btn {
            color: #FFC107;
            font-size: 1.5rem;
            text-decoration: none;
        }

        .custom-modal-body img {
            max-width: 100%;
            border-radius: 8px;
        }

        .modal-price {
            font-size: 1.4em; /* Adjust size for clarity */
            font-weight: bold;
            color: #C0272C;
            margin-top:-530px; /* Ensure space between description and price */
        }

        .modal-description {
            color: #FFC107;
        }

        .custom-modal .quantity-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .custom-modal .quantity-controls button {
                background-color: #C0272C;
                color: white;
                border: none;
                padding: 5px 10px;
                border-radius: 4px;
            }

        .custom-modal .add-to-cart-btn {
            background-color: #FFC107;
            color: black;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            font-weight: bold;
            width: 100%;
        }
        /* General styling for the cart items container */
        /* Container for the cart item */
        .cart-item {
            display: flex;
            align-items: center;
            padding: 15px;
            border-bottom: 1px solid #ddd;
            margin-bottom: 15px;
            background-color: #fff;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            border-radius: 8px;
        }

        /* Cart item image styling */
        .cart-item-image {
            flex-shrink: 0;
            width: 80px;
            height: 80px;
            margin-right: 15px;
        }

        .cart-item-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 8px;
        }

        /* Cart item info styling */
        .cart-item-info {
            flex-grow: 1;
        }

        /* Name of the food item */
        .cart-item-name {
            font-size: 1.2rem;
            font-weight: bold;
            color: #333;
            margin-bottom: 8px;
        }

        /* Quantity and price styling */
        .cart-item-quantity,
        .cart-item-price {
            font-size: 1rem;
            color: #555;
            margin-bottom: 5px;
        }

        /* Price styling */
        .cart-item-price {
            color: #e74c3c;
            font-weight: bold;
        }

        /* Style for the container */
        #cart-items-container {
            max-height: 400px;
            overflow-y: auto;
            padding: 20px;
        }


    </style>
</head>
<body>
    <section id="burger-section" class="menu-section">
        <h2 class="section-title" style="color:#C0272C; font-family:Arial, Helvetica, sans-serif; font-weight: 900; font-size: 60px; text-transform: uppercase; letter-spacing: 2px; text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.2);">Burgers</h2>
        <div class="menu-grid">
            @if (Model != null && Model.Any())
            {
                @foreach (var item in Model.Where(f => f.CategoryID == 1)) 
                {
                    <div class="menu-item">
                        <img src="@Url.Content(item.PictureURL)" alt="@item.Name" class="menu-image">
                        
                        <h3 class="menu-name">@item.Name</h3>
                        <p class="menu-description">@item.Description</p>
                        <p class="menu-price">Rs. @item.Price</p>
                      
                        <button class="btn order-now-btn order-button"
                            data-id="@item.ID"
                            data-name="@item.Name"
                            data-description="@item.Description"
                            data-price="@item.Price"
                            data-image="@Url.Content(item.PictureURL)"
                            data-rating="★★★☆☆">
                            Order Now
                        </button>
                     
                    </div>
                }
            }
            else
            {
                <p>No items available.</p>
            }
        </div>
       @*  <partial name="_OrderModal" model="@Model"></partial> *@
    </section>
    <!-- Modal -->
    <div class="modal fade" id="customModal" tabindex="-1" aria-labelledby="customModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content custom-modal">
                <!-- Modal Header -->
                <div class="modal-header custom-modal-header">
                    <h5 class="modal-title" id="modalTitle"></h5>
                    <a href="#" class="close-btn" data-bs-dismiss="modal" aria-label="Close">&times;</a>
                </div>
                <!-- Modal Body -->
                <div class="modal-body custom-modal-body">
                    <div class="row">
                        <!-- Image -->
                        <div class="col-md-6">
                            <img id="modalImage" src="" alt="Item Image" class="img-fluid">
                        </div>
                        <!-- Details -->
                        <div class="col-md-6">
                            <h4 id="modalDescription" class="modal-description"></h4>
                            <p id="modalPrice" class="modal-price"></p> <!-- Price directly below description -->
                            <p id="modalRating"></p>

                            <!-- Meal Selection -->
                            <div class="mb-3">
                                <label for="mealSelect" class="form-label">Meal</label>
                                <select class="form-select" id="mealSelect">
                                    <option selected>Combo (with drink)</option>
                                    <option value="1">Burger Only</option>
                                </select>
                            </div>

                            <!-- Quantity Controls -->
                            <div class="quantity-controls mb-3">
                                <button class="decrease-btn">-</button>
                                <input type="text" value="1" readonly style="width: 40px; text-align: center;">
                                <button class="increase-btn">+</button>
                            </div>

                            <form id="addToCartForm" method="post" action="@Url.Action("AddToCart","Cart")" onsubmit="console.log('Form is being submitted')">

                                <input type="hidden" name="foodItemId" id="modalFoodItemId" value="" />
                                <input type="hidden" name="quantity" id="modalQuantity" value="1" />
                                <input type="hidden" name="userId" value="@User.FindFirstValue(ClaimTypes.NameIdentifier)" /> 

                                <button type="submit" class="add-to-cart-btn">Add to Cart</button>
                            </form>
                           
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Initialize Bootstrap modal
            const modal = new bootstrap.Modal(document.getElementById("customModal"));

            // Order Now buttons
            const orderNowButtons = document.querySelectorAll(".order-now-btn");

            // Cart Quantity Indicator
            const cartQuantityIndicator = document.getElementById("cart-quantity");
            let cartQuantity = 0; // Initial cart quantity
            const cartItemsContainer = document.getElementById("cart-items-container");

            // Function to update cart quantity indicator
            function updateCartQuantityIndicator() {
                console.log("Updating Cart Quantity:", cartQuantity);
                cartQuantityIndicator.textContent = cartQuantity;
            }
            
            // Function to update quantity and subtotal
            function updateQuantity(inputField, isIncreasing, basePrice, priceElement, addToCartButton, mealPrice) {
                let currentValue = parseInt(inputField.value);
                if (isIncreasing) {
                    currentValue += 1;
                } else {
                    if (currentValue > 1) {
                        currentValue -= 1;
                    }
                }

                // Update the quantity field
                inputField.value = currentValue;

                // Calculate the subtotal (base price + meal price) * quantity
                const subtotal = (basePrice + mealPrice) * currentValue;

                // Update price display
                priceElement.textContent = `Price: Rs. ${subtotal}`;

                // Update "Add to Cart" button text
                addToCartButton.textContent = `Add to Cart - Rs. ${subtotal}`;
            }

            // Function to update the cart offcanvas with the new item
            function updateCartItems(item) {
                const cartItem = document.createElement("div");
                cartItem.classList.add("cart-item");

                cartItem.innerHTML = `

                <div class="cart-item-details">                 
                    <div class="cart-item-info">
                        <div class="cart-item-name">${item.name}</div>
                        <div class="cart-item-quantity">Quantity: ${item.quantity}</div>
                        <div class="cart-item-price">Price: Rs. ${item.price}</div>
                    </div>
                </div>
                    `;

                cartItemsContainer.appendChild(cartItem);
            }

            // Add event listeners for "Order Now" buttons
            orderNowButtons.forEach(button => {
                button.addEventListener("click", function () {
                    // Get the data from the button
                    const foodItemId = this.getAttribute("data-id");
                    const name = this.getAttribute("data-name");
                    const description = this.getAttribute("data-description");
                    const basePrice = parseFloat(this.getAttribute("data-price"));
                    const image = this.getAttribute("data-image");
                    const rating = this.getAttribute("data-rating");

                    // Populate modal with the item's details
                    document.getElementById("modalTitle").textContent = name;
                    document.getElementById("modalDescription").textContent = description;
                    document.getElementById("modalPrice").textContent = `Price: Rs. ${basePrice}`;
                    document.getElementById("modalImage").src = image;
                    document.getElementById("modalRating").textContent = `Rating: ${rating}`;
                    document.getElementById("modalFoodItemId").value = foodItemId;

                    // Reset quantity and meal price
                    const quantityInput = document.querySelector("#modalQuantity");
                    quantityInput.value = "1";
                    let mealPrice = 0;

                    // Add meal selection event listener
                    const mealSelect = document.getElementById("mealSelect");
                    mealSelect.addEventListener("change", function () {
                        mealPrice = this.value === "0" ? 150 : 0;
                        updateQuantity(
                            quantityInput,
                            true,
                            basePrice,
                            document.getElementById("modalPrice"),
                            document.querySelector(".add-to-cart-btn"),
                            mealPrice
                        );
                    });

                    // Add event listeners for quantity controls
                    const decreaseButton = document.querySelector(".decrease-btn");
                    const increaseButton = document.querySelector(".increase-btn");
                    decreaseButton.onclick = () => updateQuantity(
                        quantityInput,
                        false,
                        basePrice,
                        document.getElementById("modalPrice"),
                        document.querySelector(".add-to-cart-btn"),
                        mealPrice
                    );
                    increaseButton.onclick = () => updateQuantity(
                        quantityInput,
                        true,
                        basePrice,
                        document.getElementById("modalPrice"),
                        document.querySelector(".add-to-cart-btn"),
                        mealPrice
                    );

                    modal.show();
                });
            });


            // Add to Cart Form Submit
            document.querySelector("#addToCartForm").addEventListener("submit", function (e) {
                // Remove e.preventDefault() to allow form submission
                const quantityInput = document.querySelector("#modalQuantity");
                const quantity = parseInt(quantityInput.value);
                const foodItemId = document.getElementById("modalFoodItemId").value;
                const name = document.getElementById("modalTitle").textContent;
                const price = parseFloat(document.getElementById("modalPrice").textContent.replace('Price: Rs. ', ''));

                // Your cart logic
                cartQuantity += quantity;
                updateCartQuantityIndicator(); // Update the cart quantity indicator immediately

                const cartItem = {
                    name: name,
                    quantity: quantity,
                    price: price * quantity
                };

                updateCartItems(cartItem);

                modal.hide();

                // Manually submit the form after executing your logic
                //this.submit();
            });

        });

    </script>
</body>
</html>




