    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
@model ReservationConfirmationViewModel

@{
    Layout = null; // Use your layout if needed
}
<style>
    body {
        background-color: #f7f7f7;
        font-family: Arial, sans-serif;
    }

    .container {
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }

    h2 {
        font-size: 2rem;
        font-weight: bold;
        color: #28a745;
        margin-bottom: 30px;
    }

    .confirmation-details {
        background-color: #fff;
        border: 2px solid #ddd;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        padding: 30px;
        margin-top: 20px;
    }

        .confirmation-details p {
            font-size: 1.2rem;
            color: #333;
            line-height: 1.6;
        }

    .lead {
        font-weight: 600;
    }

    .btn-primary {
        background-color: #007bff;
        border-color: #007bff;
        font-size: 1.1rem;
        font-weight: bold;
        padding: 12px 30px;
        transition: background-color 0.3s, transform 0.3s ease-in-out;
    }

        .btn-primary:hover {
            background-color: #0056b3;
            transform: scale(1.05);
        }

        .btn-primary:focus {
            outline: none;
            box-shadow: none;
        }

    .btn-custom {
        display: inline-block;
        font-size: 1.25rem; /* Large font */
        padding: 15px 30px; /* Vertical and horizontal padding */
        margin: 10px; /* Spacing between buttons */
        border-radius: 50px; /* Pill shape */
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1); /* Soft shadow */
        text-decoration: none; /* Remove underline */
        font-weight: 600; /* Bold text */
        transition: transform 0.2s ease, box-shadow 0.2s ease; /* Animation */
    }

        /* Hover effect for all buttons */
        .btn-custom:hover {
            transform: translateY(-3px); /* Slight upward movement */
            box-shadow: 0 6px 8px rgba(0, 0, 0, 0.15); /* Stronger shadow */
        }

    /* Primary button specific styles */
    .btn-primary-custom {
        background-color: #007bff; /* Bootstrap primary blue */
        color: white;
        border: none;
    }

        .btn-primary-custom:hover {
            background-color: #0056b3; /* Darker blue on hover */
        }

    /* Success button specific styles */
    .btn-success-custom {
        background-color: #28a745; /* Bootstrap success green */
        color: white;
        border: none;
    }

        .btn-success-custom:hover {
            background-color: #1e7e34; /* Darker green on hover */
        }

    /* Info button specific styles */
    .btn-info-custom {
        background-color: #17a2b8; /* Bootstrap info blue */
        color: white;
        border: none;
    }

        .btn-info-custom:hover {
            background-color: #117a8b; /* Darker info blue on hover */
        }
</style>

<div class="container text-center my-5">
    <h2 class="text-success">Reservation Confirmed!</h2>

    <div class="confirmation-details my-4 p-4 border rounded shadow-lg">
        <p class="lead"><strong>Reservation Number:</strong> @Model.ReservationNumber</p>
        <p class="lead"><strong>User Name:</strong> @Model.UserName</p>
        <p class="lead"><strong>Reservation Date:</strong> @Model.ReservationDate.ToString("MMMM dd, yyyy")</p>
        <p class="lead"><strong>Reservation Time:</strong> @Model.ReservationTime</p>
        <p class="lead"><strong>Party Size:</strong> @Model.PartySize</p>
        <p class="lead"><strong>Table Number:</strong> @Model.TableNumber</p>
    </div>

    <div class="text-center my-5">
        <a href="@Url.Action("AvailableTables", "Reservation")"
           class="btn-custom btn-primary-custom">
            Back to Available Tables
        </a>

        <a href="@Url.Action("ViewMenu", "Menu")"
           class="btn-custom btn-success-custom">
            See Our Menu
        </a>

        <a href="@Url.Action("Index", "Main")"
           class="btn-custom btn-info-custom">
            Go to Homepage
        </a>
    </div>

</div>