    <!-- Bootstrap JS and Popper.js (for offcanvas functionality) -->
    <script>
        // For the first section (Section One)
        const slideInElementSectionOne = document.querySelector('.section-one .slide-in');

        // For the second section (Section Three)
        const slideInElementSectionTwo = document.querySelector('.section-three .slide-in');

        // Function to check if the element is in the viewport
        function isElementInViewport(element) {
            const rect = element.getBoundingClientRect();
            return (
                rect.top <= (window.innerHeight || document.documentElement.clientHeight) &&
                rect.bottom >= 0
            );
        }

        function handleScroll() {
            if (isElementInViewport(slideInElementSectionOne)) {
                slideInElementSectionOne.classList.add('show');
            }
            if (isElementInViewport(slideInElementSectionTwo)) {
                slideInElementSectionTwo.classList.add('show');
            }
        }

        window.addEventListener('scroll', handleScroll);

        // Initial check on page load
        handleScroll();

