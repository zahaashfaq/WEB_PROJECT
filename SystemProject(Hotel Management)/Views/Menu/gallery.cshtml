
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gallery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/css/StyleSheetforGallery.css")">
</head>
<body>

    <header>
        <div class="content">
            <h1>Gallery</h1>
            <p>Explore our beautiful collection</p>
        </div>
    </header>

    <div class="gallery-container">
        <!-- Gallery Item 1 -->
        <div class="gallery-item">
            <img src="/images/Alfredo.png" alt="Gallery Image 1">
            <div class="overlay">
                <div class="overlay-text">Alfredo</div>
            </div>
        </div>

        <!-- Gallery Item 2 -->
        <div class="gallery-item">
            <img src="/images/Biryani.jpg" alt="Gallery Image 2">
            <div class="overlay">
                <div class="overlay-text">Biryani</div>
            </div>
        </div>

        <!-- Gallery Item 3 -->
        <div class="gallery-item">
            <img src="/images/breafast.jpg" alt="Gallery Image 3">
            <div class="overlay">
                <div class="overlay-text">BreakFast</div>
            </div>
        </div>

        <!-- Gallery Item 4 -->
        <div class="gallery-item">
            <img src="/images/brunch.jpg" alt="Gallery Image 4">
            <div class="overlay">
                <div class="overlay-text">Brunch</div>
            </div>
        </div>

        <!-- Gallery Item 5 -->
        <div class="gallery-item">
            <img src="/images/festivals.jpg" alt="Gallery Image 5">
            <div class="overlay">
                <div class="overlay-text">Festival Event</div>
            </div>
        </div>

        <!-- Gallery Item 6 -->
        <div class="gallery-item">
            <img src="/images/image3.jpg" alt="Gallery Image 6">
            <div class="overlay">
                <div class="overlay-text">Drinks</div>
            </div>
        </div>
        <div class="gallery-item">
            <img src="/images/AcharChicken.jpg" alt="Gallery Image 7">
            <div class="overlay">
                <div class="overlay-text">Achar Chicken</div>
            </div>
        </div>

        <!-- Gallery Item 2 -->
        <div class="gallery-item">
            <img src="/images/image10.jpg" alt="Gallery Image 8">
            <div class="overlay">
                <div class="overlay-text">Tables</div>
            </div>
        </div>

        <!-- Gallery Item 3 -->
        <div class="gallery-item">
            <img src="/images/BRONCO2.jpg" alt="Gallery Image 9">
            <div class="overlay">
                <div class="overlay-text">Burgers</div>
            </div>
        </div>

        <!-- Gallery Item 4 -->
        <div class="gallery-item">
            <img src="/images/image11.jpg" alt="Gallery Image 10">
            <div class="overlay">
                <div class="overlay-text">Street Table</div>
            </div>
        </div>

        <!-- Gallery Item 5 -->
        <div class="gallery-item">
            <img src="/images/image12.jpg" alt="Gallery Image 11">
            <div class="overlay">
                <div class="overlay-text">Sweets</div>
            </div>
        </div>

        <!-- Gallery Item 6 -->
        <div class="gallery-item">
            <img src="/images/image8.jpg" alt="Gallery Image 12">
            <div class="overlay">
                <div class="overlay-text">Lunch</div>
            </div>
        </div>
    </div>

   
    
    <footer>
        <p>&copy; 2024 Your Company Name. All rights reserved.</p>
    </footer>

</body>
</html>
