    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.onscroll = function () {
            let navbar = document.getElementById('navbar-example2');
            if (window.pageYOffset > 610) {
                navbar.style.display = 'block';
                navbar.classList.add('sticky');
            } else {
                navbar.style.display = 'none';
                navbar.classList.remove('sticky');
            }
        };
    //newwwwwwwwwwwwwwwwwwwwwwwwwwwwww
        const track = document.querySelector('.carousel-track');
        const slides = Array.from(track.children);
        const nextButton = document.getElementById('next');
        const prevButton = document.getElementById('prev');

        // Number of slides visible in the container
        const visibleSlides = 3;
        const slideWidth = slides[0].getBoundingClientRect().width;

        let currentIndex = 0;


        const gapSize = 15; // Gap size in pixels
        const setSlidePosition = (slide) => {
            // Subtract the total gap from the slide width percentage
            const adjustedWidth = (100 / visibleSlides) - (gapSize / slide.parentElement.getBoundingClientRect().width) * 100;
            slide.style.width = `${adjustedWidth}%`;
            slide.style.margin = `0 ${gapSize / 2}px`; // Apply half the gap size on both sides
        };

        // Apply the settings to all slides
        slides.forEach(setSlidePosition);

        // Remove left property adjustments as flexbox handles alignment
        slides.forEach(setSlidePosition);

        const moveSlides = (index) => {
            track.style.transform = `translateX(-${slideWidth * index}px)`;
            currentIndex = index;

            // Update button states
            prevButton.disabled = currentIndex === 0;
            nextButton.disabled = currentIndex >= slides.length - visibleSlides;
        };

        // Move to the next set of slides
        nextButton.addEventListener('click', () => {
            const maxIndex = slides.length - visibleSlides;
            const targetIndex = Math.min(currentIndex + visibleSlides, maxIndex);
            moveSlides(targetIndex);
        });

        // Move to the previous set of slides
        prevButton.addEventListener('click', () => {
            const targetIndex = Math.max(currentIndex - visibleSlides, 0);
            moveSlides(targetIndex);
        });

        // Scroll to the respective section when a carousel item is clicked
        slides.forEach((slide) => {
            slide.addEventListener('click', () => {
                const sectionId = slide.getAttribute('data-section-id');
                const targetSection = document.getElementById(sectionId);

                if (targetSection) {
                    targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        });

     
        moveSlides(0); 
           
        document.getElementById("searchBar").addEventListener("input", function () {
            const query = this.value.trim();

            if (query.length > 0) {
                fetch(`/FoodItem/SearchProducts?query=${encodeURIComponent(query)}`)
                    .then(response => response.json())
                    .then(products => displayProducts(products))
                    .catch(error => console.error('Error:', error));
            } else {
                fetchAllProducts(); // Optional: reload all products if search is cleared
            }
        });

        function displayProducts(products) {
            const container = document.getElementById("productContainer");
            container.innerHTML = ""; // Clear existing products

            products.forEach(product => {
                const productHTML = `
                    <div class="product">
                        <img src="${product.pictureURL}" alt="${product.name}" class="product-img">
                        <h3>${product.name}</h3>
                        <p>${product.description}</p>
                        <p>Price: Rs. ${product.price}</p>
                    </div>
                `;
                container.innerHTML += productHTML;
            });
        }

        function fetchAllProducts() {
            fetch('/FoodItem/GetAllProducts') // Assuming you have an endpoint to fetch all products
                .then(response => response.json())
                .then(products => displayProducts(products))
                .catch(error => console.error('Error:', error));
        }

    </script>

