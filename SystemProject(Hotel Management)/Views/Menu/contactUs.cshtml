@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />
    <style>
        /* Custom CSS */
        <style>
        /* Custom CSS */
        body {
            font-family: 'Roboto', sans-serif;
            background: linear-gradient(to right, rgb(18, 35, 54), #1a2a44);
            color: white;
            margin: 0;
            padding: 0;
        }

        header {
            background-color: #d1a663;
            padding: 40px 20px;
            text-align: center;
            border-bottom: 5px solid #1a2a44;
        }

        header h1 {
            margin: 0;
            color: white;
            font-size: 2.5rem;
            letter-spacing: 2px;
        }

        .contact-container {
            display: flex;
            justify-content: space-between;
            margin: 40px 10%;
            flex-wrap: wrap;
        }

        .contact-form,
        .contact-info {
            background-color: rgba(18, 35, 54, 0.8);
            padding: 40px;
            border-radius: 8px;
            box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
            width: 48%;
            transition: transform 0.3s ease-in-out;
        }

        .contact-form h2,
        .contact-info h2 {
            color: #d1a663;
            margin-bottom: 25px;
            font-size: 1.8rem;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 15px;
            margin-bottom: 20px;
            border-radius: 5px;
            border: 2px solid #ddd;
            background-color: #2c3e50;
            color: white;
            font-size: 1rem;
            transition: border-color 0.3s ease-in-out;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #d1a663;
            outline: none;
        }

        .contact-form button {
            background-color: #d1a663;
            color: white;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            width: 100%;
            cursor: pointer;
            font-size: 1.2rem;
            transition: background-color 0.3s ease-in-out;
        }

        .contact-form button:hover {
            background-color: #C27C2F;
        }

        .contact-info p {
            font-size: 1.2rem;
            margin-bottom: 20px;
            line-height: 1.6;
        }

        .contact-info a {
            color: #d1a663;
            text-decoration: none;
            transition: color 0.3s ease-in-out;
        }

        .contact-info a:hover {
            color: #f39c12;
            text-decoration: underline;
        }

        footer {
            background-color: #d1a663;
            color: white;
            padding: 15px;
            text-align: center;
            position: relative;
            bottom: 0;
            width: 100%;
        }

        

        /* Hover animation for contact cards */
        .contact-form:hover, .contact-info:hover {
            transform: translateY(-10px);
        }

        /* Smooth Scroll */
        html {
            scroll-behavior: smooth;
        }
    </style>
</head>
<body>

    <header>
        <h1>Contact Us</h1>
    </header>

    <div class="contact-container">
        <!-- Contact Form -->
        <div class="contact-form">
            <h2>We'd Love to Hear from You!</h2>
            <form action="#" method="POST">
                <input type="text" name="name" placeholder="Your Name" required>
                <input type="email" name="email" placeholder="Your Email" required>
                <textarea name="message" placeholder="Your Message" rows="5" required></textarea>
                <button type="submit">Send Message</button>
            </form>
        </div>

        <!-- Contact Info -->
        <div class="contact-info">
            <h2>Our Office</h2>
            <p><strong>Address:</strong> 123 Business St., City, Country</p>
            <p><strong>Phone:</strong> <a href="tel:+1234567890">+123 456 7890</a></p>
            <p><strong>Email:</strong> <a href="mailto:info@company.com">info@company.com</a></p>
            <p><strong>Business Hours:</strong> Mon - Fri: 9:00 AM - 6:00 PM</p>
        </div>
    </div>

    <footer>
        <p>&copy; 2024 Your Company Name. All rights reserved.</p>
    </footer>

</body>
</html>